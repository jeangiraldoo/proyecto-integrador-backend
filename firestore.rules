rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.created_by;

      // Subcollection: /rooms/{roomId}/messages/{messageId}
      match /messages/{messageId} {
        allow read: if request.auth != null;
        // sender_id must match the authenticated user's UID — prevents impersonation
        allow create: if request.auth != null && request.auth.uid == request.resource.data.sender_id;
        allow update, delete: if request.auth != null && request.auth.uid == resource.data.sender_id;
      }
    }
  }
}
